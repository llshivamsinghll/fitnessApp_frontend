# Frontend Configuration
VITE_APP_TITLE=FitAI - Your Professional AI Fitness Assistant
VITE_APP_DESCRIPTION=Get personalized workout plans and nutrition guidance powered by artificial intelligence
VITE_APP_VERSION=1.0.0

# API Configuration
# Default local backend URL. Production overrides this in .env.production.
VITE_API_BASE_URL=http://localhost:10000
VITE_API_TIMEOUT=120000

# Development Server Configuration
VITE_DEV_PORT=8080
VITE_DEV_HOST=::

# Backend Proxy Configuration (for development)
VITE_BACKEND_URL=http://localhost:10000

# Authentication Configuration
VITE_AUTH_TOKEN_KEY=auth_token
VITE_SESSION_TIMEOUT=24h

# Application Features
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DEBUG=true
VITE_ENABLE_PWA=false

# External Services (if needed in future)
VITE_SENTRY_DSN=
VITE_GOOGLE_ANALYTICS_ID=

# Environment
NODE_ENV=development
